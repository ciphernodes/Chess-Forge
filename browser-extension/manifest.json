{
  "manifest_version": 3,
  "name": "Chess Forge — Stockfish WASM Analyzer",
  "short_name": "Chess Forge",
  "version": "2.1.0",
  "description": "Local Stockfish 19 WebAssembly chess analysis, Master Opening Book lookup, board-theme contrast adaptation, move annotations (!!/?!), and SVG arrows for Lichess.org and Chess.com.",
  "permissions": [
    "storage",
    "activeTab",
    "offscreen"
  ],
  "host_permissions": [
    "https://lichess.org/*",
    "https://*.lichess.org/*",
    "https://www.chess.com/*",
    "https://*.chess.com/*",
    "https://explorer.lichess.ovh/*",
    "https://tablebase.lichess.ovh/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Chess Forge",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/stockfish-19-lite-single.js",
        "vendor/stockfish-19-lite-single.wasm"
      ],
      "matches": [
        "https://lichess.org/*",
        "https://*.lichess.org/*",
        "https://www.chess.com/*",
        "https://*.chess.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://lichess.org/*",
        "https://*.lichess.org/*",
        "https://www.chess.com/*",
        "https://*.chess.com/*"
      ],
      "js": [
        "src/chess-engine.js",
        "src/opening-book.js",
        "src/syzygy-tablebase.js",
        "src/content.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ]
}
